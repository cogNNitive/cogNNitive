{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*",
    "skills/**/*"
  ],
  "exclude": [
    "skills/**/test/**",
    "node_modules",
    "**/*.test.js",
    "**/test-*.js",
    "**/*.generated.cjs"
  ]
}
