#!/bin/sh
# pre-push: block the push if the repo does not typecheck, or if the generated
# docs-derived facts are stale.
#
# Typecheck runs `npm run typecheck` (root, both workspaces, includes the
# innfo-core build)
# — the cheapest command that catches the class of defect
# that caused incident 2c11ecf (a vue-tsc TS2367 dead comparison).
# Deliberately NOT `npm run verify` (typecheck + full test suite, several minutes): a hook that takes minutes trains people to reach for
# --no-verify as a habit, which disarms every future hook. See design.md
# ADR-001.
#
# This hook reads $remote_ref from stdin (one line per pushed ref:
# "<local_ref> <local_sha> <remote_ref> <remote_sha>"), so it now:
#   - skips typecheck entirely for pushes whose remote ref is not
#     refs/heads/* (tag pushes, e.g. a release cutting up to four tags),
#   - skips ref deletions (local sha is all zeros),
#   - runs the typecheck in session worktrees too: they carry their own real
#     `npm ci` install (nn-session start), so @cognnitive/* resolves to the
#     worktree itself. Use `nn-session start --no-install` + `--no-verify` only
#     when you knowingly skip the install.

typechecked=0
docs_checked=0
guards_checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Ref deletion: local sha is all zeros. Nothing to check.
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  case "$remote_ref" in
    refs/heads/*)
      if [ "$typechecked" -eq 0 ]; then
        export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"
        npm run typecheck
        status=$?
        if [ "$status" -ne 0 ]; then
          echo ""
          echo "pre-push: typecheck failed (exit $status). Push blocked."
          echo "pre-push: fix the errors above, or bypass with: git push --no-verify"
          exit "$status"
        fi
        typechecked=1
      fi

      if [ "$docs_checked" -eq 0 ]; then
        # Docs-derived-facts drift guard. The generated `mcp-tools` region in
        # docs/innfo/documentation/innfo-mcp.md and skills/nn-innfo/SKILL.md must
        # match the innfo-mcp tool registry; editing a tool description without
        # re-running the generator lands a red dev tip and blocks the next
        # dev->main batch (2026-10-11 and 2026-10-17). Cheap (~5s) and the only
        # local trigger for it. The mcp dist is not produced by typecheck, so
        # build it first with `build:dist` (dist only — a plain build would also
        # rewrite the committed bin/ bundle); unchanged source rebuilds
        # byte-identically, so the working tree stays clean.
        npm --workspace=@cognnitive/innfo-mcp run build:dist >/dev/null 2>&1
        node scripts/generate-docs-facts.mjs --check
        status=$?
        if [ "$status" -ne 0 ]; then
          echo ""
          echo "pre-push: generated docs facts are stale (exit $status). Push blocked."
          echo "pre-push: run 'npm run regen' (or 'node scripts/generate-docs-facts.mjs') and commit the result."
          echo "pre-push: bypass with: git push --no-verify"
          exit "$status"
        fi
        docs_checked=1
      fi

      if [ "$guards_checked" -eq 0 ]; then
        # Derived-artifact freshness guards (list shared with scripts/verify.js)
        # plus eslint on the files changed against origin/dev. CI was otherwise
        # the first place these ran: 22 of the last 100 CI runs failed on lint
        # and 10 on stale generated files.
        node scripts/pre-push-check.js "$local_sha"
        status=$?
        if [ "$status" -ne 0 ]; then
          exit "$status"
        fi
        guards_checked=1
      fi
      ;;
    *)
      # Not a branch push (e.g. refs/tags/*) — typecheck does not apply.
      ;;
  esac
done

exit 0

