#!/bin/sh
# pre-push: forward git's stdin ref lines to scripts/pre-push-check.js, which owns
# the whole gate:
#   1. fast-path — a push of `refs/heads/session/*` branches only exits 0 without
#      running the heavy pipeline; CI gates the pull request.
#   2. `npm run typecheck` and the docs-derived-facts prerequisite,
#   3. the derived-artifact freshness guards, run concurrently,
#   4. eslint, scoped to files changed against origin/main.
#
# This hook reads $remote_ref from stdin (one line per pushed ref:
# "<local_ref> <local_sha> <remote_ref> <remote_sha>"). It never checks out or
# mutates the working tree; a hook that takes minutes trains people to reach for
# --no-verify as a habit, which disarms every future hook. See design.md ADR-001.

refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT INT TERM
cat > "$refs_file" || true

# Tag-only pushes carry nothing for this gate; let them through.
if ! grep -q ' refs/heads/' "$refs_file"; then
  exit 0
fi

node scripts/pre-push-check.js "$1" "$2" < "$refs_file"
exit $?
