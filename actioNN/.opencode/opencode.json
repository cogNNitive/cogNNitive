{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["https://raw.githubusercontent.com/cogNNitive/eNNvironment/main/docs/use/manifest.md"],
  "mcp": {
    "innfo-mcp": {
      "type": "local",
      "command": ["node", ".cogNNitive/mcp-bundle.js"],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.spec-cache/**"
    ]
  }
}
