{
  "name": "@cognnitive/innfo-editor",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../../packages/innfo-core run build",
    "dev": "vite",
    "prebuild": "npm --prefix ../../packages/innfo-core run build",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "pretest": "npm --prefix ../../packages/innfo-core run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cognnitive/innfo-core": "*",
    "@tanstack/vue-virtual": "^3.13.31",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.2.0",
    "lucide-vue-next": "^0.395.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "pinia": "^2.1.0",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.8",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^14.0.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
