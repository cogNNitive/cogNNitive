{
  "name": "@cognnitive/nn-mcp",
  "version": "0.30.0",
  "description": "MCP server wrapping @cognnitive/nn-core - semantic iNNfo tools over stdio",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "nn-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:dist": "tsup --config tsup.dist.config.ts",
    "build:bundle": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20.15"
  },
  "dependencies": {
    "@cognnitive/nn-core": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
