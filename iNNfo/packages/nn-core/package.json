{
  "name": "@cognnitive/nn-core",
  "version": "0.32.0",
  "description": "Core library for iNNfo parser, model, IO drivers, and validator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
