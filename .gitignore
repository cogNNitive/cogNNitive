# Dependencies
node_modules/
**/node_modules/

# Production & Build outputs
dist/
**/dist/
build/
**/build/
docs/innfo/app/assets/
docs/innfo/app/index.html
docs/innfo/cdn/*.bundle.js

# Test reports & Coverage
coverage/
**/coverage/
e2e-reports/
**/e2e-reports/
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# Agent & Tooling caches/artifacts
.playwright-mcp/
**/.playwright-mcp/
.spec-cache/
**/.spec-cache/
# Misdirected spec-resolution cache (belongs in .spec-cache/): resolver writes a
# bare specs/ dir relative to cwd. Never the real spec trees (iNNfo/specs/, openspec/specs/).
/specs/
iNNfo/specs/templates/**/specs/
.atl/.skill-registry.cache.json
.cogNNitive/.skill-registry.cache.json
sources/staging/
**/sources/staging/

# Environment & Logs
.env
.env.local
*.log
npm-debug.log*
yarn-debug.log*

# OS Files
.DS_Store
Thumbs.db

# Disposable agent scratch (SIM workspaces, ad-hoc scripts — never committed)
temp/
