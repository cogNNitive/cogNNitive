# Dependencies
node_modules/
**/node_modules/

# Production & Build outputs
dist/
**/dist/
build/
**/build/
# Console export output root at the repo root (scripts/export-console.mjs).
# Root-anchored on purpose: `artifacts/` also names tracked domain/use-case
# folders and test fixtures elsewhere.
/artifacts/
docs/innfo/cdn/
docs/use/freshness.json
docs/use/manifest.md
docs/update/manifest.md
.release-manifest.md

# Test reports & Coverage
coverage/
**/coverage/
e2e-reports/
**/e2e-reports/
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# Agent & Tooling caches/artifacts
.cogNNitive/
**/.cogNNitive/
.playwright-mcp/
**/.playwright-mcp/
.opencode/
**/.opencode/
# Workspace-local cache (watch-root digest state, skill registry) — never tracked
.cognnitive/
**/.cognnitive/
# Engram memory sync export (contains local absolute paths + raw session
# observations; repo is public, keep this local-only per-profile instead)
.engram/
**/.engram/

# Dogfooding workspace: resolver spec caches (regenerated by nn-mcp on open).
# Version-agnostic on purpose: the previous rules pinned the exact spec version
# (iNNfo_V_0-2-0) and the old workspace directory name (_NN/, which no longer
# exists), so both went dead and the cache resurfaced as untracked noise.
# Authored specs (*_spec_NN.md) stay tracked.
# Dogfooding domaiNN root (renamed from workspace_NN): resolver spec cache,
# regenerated by nn-mcp on open. Authored specs stay tracked.
ecosystem_NN/.atl/
ecosystem_NN/specs/**
!ecosystem_NN/specs/**/*_spec_NN.md
.spec-cache/
**/.spec-cache/
# Misdirected spec-resolution cache (belongs in .spec-cache/): resolver writes a
# bare specs/ dir relative to cwd. Never the real spec trees (iNNfo/specs/, openspec/specs/).
/specs/
iNNfo/specs/templates/**/specs/
**/.skill-registry.cache.json
sources/staging/
**/sources/staging/

# Environment & Logs
.env
.env.local
*.log
npm-debug.log*
yarn-debug.log*

# OS Files
.DS_Store
Thumbs.db

# Disposable agent scratch (SIM workspaces, ad-hoc scripts — never committed)
temp/
# Local AI runtime state
.atl/

# nn-sources test byproduct: test/unit/test-config.js writes it into the skill dir
skills/nn-sources/config.json
# verify.js per-step logs
.verify-logs/

# Generated console artifacts inside the sample domain (regenerate with scripts/export-console.mjs)
_samples_nn/domaiNN_console.html
_samples_nn/artifacts/*_console/
