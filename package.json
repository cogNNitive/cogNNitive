{
  "name": "cognnitive",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "iNNfo/packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build:console": "node scripts/build-console-bundle.mjs",
    "check:console-bundle": "node scripts/build-console-bundle.mjs --check",
    "build:docs": "node scripts/build-docs.mjs",
    "stage:mcp-bundle": "node scripts/stage-mcp-bundle.mjs",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint iNNfo/ scripts/",
    "lint:fix": "eslint iNNfo/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --workspace=@cognnitive/innfo-core run build && npm --workspace=@cognnitive/innfo-mcp run typecheck",
    "test": "npm --workspace=@cognnitive/innfo-core test && npm --workspace=@cognnitive/innfo-mcp test",
    "test:coverage": "npm --workspace=@cognnitive/innfo-core run test:coverage && npm --workspace=@cognnitive/innfo-mcp run test:coverage",
    "verify": "npm run typecheck && npm test",
    "test:ui": "python test/ui/testlab_smoke.py --lab-root test/fixtures/testlab --out-dir temp/ui-smoke",
    "check:integrity": "node scripts/check-integrity.js",
    "check:licenses": "node scripts/check-licenses.mjs --check",
    "licenses:write": "node scripts/check-licenses.mjs --write",
    "sync:samples": "node scripts/sync-samples.mjs",
    "check:samples": "node scripts/sync-samples.mjs --check",
    "sync:versions": "node scripts/sync-versions.mjs && node scripts/blueprint-catalog.mjs",
    "check:versions": "node scripts/sync-versions.mjs --check && node scripts/blueprint-catalog.mjs --check",
    "check:spec-version": "node scripts/check-spec-version.mjs",
    "check:spec-urls": "node scripts/check-spec-version.mjs --check-urls",
    "check:specs": "node scripts/check-spec-version.mjs --check-urls && node scripts/check-spec-version.mjs --inventory"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.13.9",
    "ajv": "^8.17.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "happy-dom": "^20.8.9",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  }
}
