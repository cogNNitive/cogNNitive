{
  "name": "cognnitive",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "iNNfo/packages/*"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build:console": "node scripts/build-console-bundle.mjs",
    "perf:workspace-kb": "node scripts/perf-workspace-kb.mjs",
    "check:console-bundle": "node scripts/build-console-bundle.mjs --check",
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "stage:mcp-bundle": "node scripts/stage-mcp-bundle.mjs",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint iNNfo/ scripts/",
    "lint:fix": "eslint iNNfo/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --workspace=@cognnitive/nn-core run build && npm --workspace=@cognnitive/nn-mcp run typecheck",
    "test": "npm --workspace=@cognnitive/nn-core test && npm --workspace=@cognnitive/nn-mcp test",
    "test:coverage": "npm --workspace=@cognnitive/nn-core run test:coverage && npm --workspace=@cognnitive/nn-mcp run test:coverage",
    "verify": "npm run typecheck && npm test",
    "test:ui": "python test/ui/testlab_smoke.py --lab-root test/fixtures/testlab --out-dir temp/ui-smoke",
    "check:integrity": "node scripts/check-integrity.js",
    "check:licenses": "node scripts/check-licenses.mjs --check",
    "licenses:write": "node scripts/check-licenses.mjs --write",
    "sync:samples": "node scripts/sync-samples.mjs",
    "check:samples": "node scripts/sync-samples.mjs --check",
    "sync:versions": "node scripts/sync-versions.mjs && node scripts/blueprint-catalog.mjs",
    "check:versions": "node scripts/sync-versions.mjs --check && node scripts/blueprint-catalog.mjs --check",
    "check:spec-version": "node scripts/check-spec-version.mjs",
    "check:spec-urls": "node scripts/check-spec-version.mjs --check-urls",
    "check:specs": "node scripts/check-spec-version.mjs --check-urls && node scripts/check-spec-version.mjs --inventory",
    "check:openspec": "node scripts/check-openspec-deltas.mjs",
    "regen": "node scripts/regen.js",
    "verify:fast": "node scripts/verify.js --fast"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.13.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
